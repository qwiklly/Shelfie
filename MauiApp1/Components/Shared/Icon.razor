@* Inline SVG icons: the app must look right offline, so no icon fonts from a CDN. *@
<svg class="icon @Class" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "home":
            <path d="M3 11l9-8 9 8" /><path d="M5 10v10h14V10" /><path d="M10 20v-6h4v6" />
            break;
        case "grid":
            <rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" />
            break;
        case "scan":
            <path d="M3 7V4h3M18 4h3v3M21 17v3h-3M6 20H3v-3" /><path d="M7 8v8M10 8v8M13 8v8M16 8v8" />
            break;
        case "cart":
            <circle cx="9" cy="20" r="1.5" /><circle cx="18" cy="20" r="1.5" /><path d="M2 3h3l2.5 12h11L21 7H6" />
            break;
        case "settings":
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" />
            break;
        case "back":
            <path d="M15 18l-6-6 6-6" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "minus":
            <path d="M5 12h14" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" />
            break;
        case "bell":
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.7 21a2 2 0 0 1-3.4 0" />
            break;
        case "trash":
            <path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M6 6l1 14h10l1-14" />
            break;
        case "sync":
            <path d="M21 12a9 9 0 0 1-15.5 6.3L3 16" /><path d="M3 12a9 9 0 0 1 15.5-6.3L21 8" /><path d="M21 3v5h-5M3 21v-5h5" />
            break;
        case "offline":
            <path d="M2 2l20 20" /><path d="M8.5 16.4a5 5 0 0 1 7 0M5 12.9a10 10 0 0 1 5.2-2.8M19 12.9a10 10 0 0 0-2.2-1.6M2 8.8a15 15 0 0 1 4.2-2.6M22 8.8A15 15 0 0 0 10.7 5" /><circle cx="12" cy="20" r="1" />
            break;
        case "camera":
            <path d="M3 8h4l2-3h6l2 3h4v12H3z" /><circle cx="12" cy="13" r="4" />
            break;
        case "image":
            <rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="M21 15l-5-5L5 21" />
            break;
        case "food":
            <path d="M5 3v8a3 3 0 0 0 6 0V3M8 3v18M17 3c-2 0-3 3-3 6s1 4 3 4v8" />
            break;
        case "pill":
            <rect x="2" y="8" width="20" height="8" rx="4" transform="rotate(-45 12 12)" /><path d="M8.5 8.5l7 7" />
            break;
        case "book":
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z" /><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5" />
            break;
        case "box":
            <path d="M21 8l-9-5-9 5 9 5z" /><path d="M3 8v8l9 5 9-5V8" /><path d="M12 13v8" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" />
            break;
        case "up":
            <path d="M18 15l-6-6-6 6" />
            break;
        case "down":
            <path d="M6 9l6 6 6-6" />
            break;
        case "check":
            <path d="M20 6L9 17l-5-5" />
            break;
        case "share":
            <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" />
            break;
        case "user":
            <circle cx="12" cy="8" r="4" /><path d="M4 21a8 8 0 0 1 16 0" />
            break;
        case "history":
            <path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /><path d="M12 7v5l4 2" />
            break;
        default:
            <circle cx="12" cy="12" r="9" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 22;
    [Parameter] public string? Class { get; set; }

    /// <summary>Icon for a category kind.</summary>
    public static string ForKind(CategoryKind kind) => kind switch
    {
        CategoryKind.Products => "food",
        CategoryKind.Medications => "pill",
        CategoryKind.Books => "book",
        _ => "box"
    };
}
