@page "/categories"
@implements IDisposable

<header class="page-header">
    <h1>@L["Categories"]</h1>
</header>

<div class="category-grid">
    @foreach (var category in categories)
    {
        <a class="category-tile" href="/category/@category.Id">
            <span class="category-icon"><Icon Name="@Icon.ForKind(category.Kind)" Size="30" /></span>
            <span class="name">@category.Name</span>
            <span class="muted small">@counts.GetValueOrDefault(category.Id)</span>
        </a>
    }
    <button class="category-tile add" @onclick="() => showAdd = true">
        <span class="category-icon"><Icon Name="plus" Size="30" /></span>
        <span class="name">@L["Add"]</span>
    </button>
</div>

@if (showAdd)
{
    <div class="modal-overlay" @onclick="Close">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h3>@L["AddNewCategory"]</h3>
            <input @bind="newName" @bind:event="oninput" placeholder="@L["NameOfCategory"]" />
            @if (error != null)
            {
                <p class="error-text">@error</p>
            }
            <div class="modal-actions">
                <button class="btn-secondary" @onclick="Close">@L["Cancel"]</button>
                <button class="btn-primary" @onclick="Create">@L["Create"]</button>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoryDto> categories = new();
    private Dictionary<Guid, int> counts = new();
    private bool showAdd;
    private string newName = "";
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Inventory.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        categories = await Inventory.GetCategoriesAsync();
        counts = (await Inventory.GetItemsAsync()).GroupBy(i => i.CategoryId).ToDictionary(g => g.Key, g => g.Count());
    }

    private async Task Create()
    {
        var category = new CategoryDto { Name = newName };
        var result = await Inventory.SaveCategoryAsync(category);
        if (!result.Success)
        {
            error = result.ErrorText;
            return;
        }

        Close();
        // A new category starts with its fields.
        Nav.NavigateTo($"/category/{category.Id}/settings");
    }

    private void Close()
    {
        showAdd = false;
        newName = "";
        error = null;
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose() => Inventory.Changed -= OnChanged;
}
