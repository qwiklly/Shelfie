@page "/home"
@implements IDisposable

<header class="page-header">
    <h1>Shelfie</h1>
    <a class="icon-btn" href="/history" title="@L["History"]"><Icon Name="history" /></a>
</header>

@if (stats == null)
{
    <p class="muted center">@L["Loading"]</p>
}
else
{
    @if (stats.TotalItems == 0)
    {
        <section class="card hint-card">
            <div class="card-title"><Icon Name="plus" Size="18" /> @L["HomeEmptyTitle"]</div>
            <p class="muted">@L["HomeEmptyText"]</p>
            <div class="two-cols">
                <a class="btn-primary" href="/item/new/@BuiltInCategories.Products">@L["AddFirstItem"]</a>
                <a class="btn-secondary" href="/scan"><Icon Name="scan" Size="16" /> @L["Scan"]</a>
            </div>
        </section>
    }

    <section class="tiles">
        <a class="tile" href="/categories"><b>@stats.TotalItems</b><span>@L["ItemsTotal"]</span></a>
        <a class="tile warn" href="/expiring"><b>@stats.SoonCount</b><span>@L["ExpiringSoon"]</span></a>
        <a class="tile danger" href="/expiring?tab=expired"><b>@stats.ExpiredCount</b><span>@L["Expired"]</span></a>
        <a class="tile" href="/shopping"><b>@stats.ShoppingCount</b><span>@L["ToBuy"]</span></a>
    </section>

    @if (stats.Expiring.Count > 0)
    {
        <section class="card">
            <div class="card-title"><Icon Name="bell" Size="18" /> @L["NeedsAttention"] <a class="more" href="/expiring">@L["All"]</a></div>
            @foreach (var item in stats.Expiring.Take(5))
            {
                <a class="row-link" href="/item/@item.Id">
                    <span class="grow">@item.Name</span>
                    <ExpiryBadge Date="item.ExpirationDate" />
                </a>
            }
        </section>
    }

    <section class="card">
        <div class="card-title"><Icon Name="grid" Size="18" /> @L["Categories"]</div>
        @foreach (var category in categories)
        {
            var count = stats.ItemsPerCategory.GetValueOrDefault(category.Id);
            <a class="category-bar" href="/category/@category.Id">
                <Icon Name="@Icon.ForKind(category.Kind)" Size="18" />
                <span class="grow">@category.Name</span>
                <span class="bar"><span style="width:@(BarWidth(count))%"></span></span>
                <b>@count</b>
            </a>
        }
    </section>

    <section class="card">
        <div class="card-title"><Icon Name="clock" Size="18" /> @L["Last30Days"]</div>
        @if (stats.UsedShare is double share)
        {
            <div class="usage-bar">
                <span class="used" style="width:@((int)(share * 100))%"></span>
            </div>
            <div class="usage-legend">
                <span><i class="dot used"></i>@L["Consumed"]: @stats.Consumed</span>
                <span><i class="dot wasted"></i>@L["Wasted"]: @stats.Wasted</span>
            </div>
        }
        else
        {
            <p class="muted">@L["NoStatsYet"]</p>
        }
        <p class="muted small">@string.Format(L["AddedCount"], stats.Added)</p>
    </section>

    @if (history.Count > 0)
    {
        <section class="card">
            <div class="card-title"><Icon Name="history" Size="18" /> @L["RecentOperations"] <a class="more" href="/history">@L["All"]</a></div>
            @foreach (var entry in history)
            {
                <HistoryRow Entry="entry" />
            }
        </section>
    }
}

@code {
    private DashboardStats? stats;
    private List<CategoryDto> categories = new();
    private List<HistoryEntryDto> history = new();

    protected override async Task OnInitializedAsync()
    {
        Inventory.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        categories = await Inventory.GetCategoriesAsync();
        stats = await Inventory.GetDashboardAsync(Settings.SoonDays);
        history = await Inventory.GetHistoryAsync(3);
    }

    private int BarWidth(int count)
    {
        int max = Math.Max(1, stats!.ItemsPerCategory.Values.DefaultIfEmpty(0).Max());
        return count == 0 ? 2 : Math.Max(4, count * 100 / max);
    }

    private void OnChanged(object? sender, EventArgs e) => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose() => Inventory.Changed -= OnChanged;
}
