@inherits LayoutComponentBase
@implements IDisposable
@inject SyncCoordinator Sync

<div class="app-shell">
    @if (ShowSyncBanner)
    {
        <div class="sync-banner @(status.State == SyncState.Error ? "error" : "")" @onclick="SyncNow">
            <Icon Name="@(status.State == SyncState.Syncing ? "sync" : "offline")" Size="16" Class="@(status.State == SyncState.Syncing ? "spin" : null)" />
            <span>@BannerText</span>
        </div>
    }

    <main class="app-content">
        @Body
    </main>

    @if (ShowNav)
    {
        <nav class="bottom-nav">
            <NavLink href="/home" class="nav-item" Match="NavLinkMatch.Prefix"><Icon Name="home" /><span>@L["Home"]</span></NavLink>
            <NavLink href="/categories" class="nav-item"><Icon Name="grid" /><span>@L["Categories"]</span></NavLink>
            <NavLink href="/scan" class="nav-item nav-scan"><Icon Name="scan" Size="28" /></NavLink>
            <NavLink href="/shopping" class="nav-item"><Icon Name="cart" /><span>@L["Shopping"]</span></NavLink>
            <NavLink href="/settings" class="nav-item"><Icon Name="settings" /><span>@L["Settings"]</span></NavLink>
        </nav>
    }

    @if (toast != null)
    {
        <div class="toast @(toastIsError ? "error" : "")" @onclick="() => toast = null">@toast</div>
    }
</div>

@code {
    private SyncStatus status = new(SyncState.NotSignedIn, null, 0);
    private string? toast;
    private bool toastIsError;
    private CancellationTokenSource? toastTimer;

    // Start, sign-in and registration screens are full screen.
    private bool ShowNav
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0];
            return path is not ("" or "welcome" or "register");
        }
    }

    // Shown only when it matters: offline/error with unsynced changes, or while syncing many changes.
    private bool ShowSyncBanner => ShowNav && status.State switch
    {
        SyncState.Offline => status.PendingChanges > 0,
        SyncState.Error => true,
        SyncState.Syncing => status.PendingChanges > 5,
        _ => false
    };

    private string BannerText => status.State switch
    {
        SyncState.Syncing => L["SyncInProgress"],
        SyncState.Error => $"{L["SyncError"]}: {status.Message}",
        _ => string.Format(L["OfflinePending"], status.PendingChanges)
    };

    protected override void OnInitialized()
    {
        status = Sync.Status;
        Sync.StatusChanged += OnStatusChanged;
        Toasts.Shown += OnToast;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnStatusChanged(object? sender, SyncStatus s)
    {
        status = s;
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(async () =>
    {
        StateHasChanged();
        try { await JS.InvokeVoidAsync("shelfieScrollTop"); } catch (JSException) { }
    });

    private void OnToast(string message, bool isError)
    {
        toast = message;
        toastIsError = isError;
        toastTimer?.Cancel();
        toastTimer = new CancellationTokenSource();
        var token = toastTimer.Token;
        _ = Task.Delay(3500, token).ContinueWith(_ =>
        {
            if (!token.IsCancellationRequested)
            {
                toast = null;
                InvokeAsync(StateHasChanged);
            }
        }, TaskScheduler.Default);
        InvokeAsync(StateHasChanged);
    }

    private async Task SyncNow() => await Sync.SyncNowAsync();

    public void Dispose()
    {
        Sync.StatusChanged -= OnStatusChanged;
        Toasts.Shown -= OnToast;
        Nav.LocationChanged -= OnLocationChanged;
        toastTimer?.Cancel();
    }
}
